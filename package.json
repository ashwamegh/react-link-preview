{
  "name": "@ashwamegh/react-link-preview",
  "version": "1.0.1",
  "private": false,
  "description": "A component package which helps you render the preview of any link",
  "author": "ashwamegh",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.modern.js",
  "source": "src/index.js",
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "build": "microbundle-crl --no-compress --format modern,cjs",
    "start": "microbundle-crl watch --no-compress --format modern,cjs",
    "prepublish": "run-s build",
    "test": "run-s test:unit test:lint test:build",
    "test:build": "run-s build",
    "test:lint": "eslint .",
    "test:unit": "react-scripts test --env=jsdom --watchAll=false",
    "test:watch": "react-scripts test --env=jsdom",
    "predeploy": "cd example && yarn install && yarn run build",
    "deploy": "gh-pages -d example/build"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/ashwamegh/react-link-preview.git"
  },
  "homepage": "https://github.com/ashwamegh/react-link-preview#readme",
  "readme": "https://github.com/ashwamegh/react-link-preview/blob/master/README.md",
  "funding": [
    {
      "type": "buymeacoffee",
      "url": "https://www.buymeacoffee.com/ashwameghwork"
    },
    {
      "type": "patreon",
      "url": "https://patreon.com/ashwamegh"
    }
  ],
  "peerDependencies": {
    "prop-types": "^15.8.1",
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "babel-eslint": "^10.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^8",
    "eslint-config-prettier": "^9",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "gh-pages": "^6.3.0",
    "microbundle-crl": "^0.13.11",
    "npm-run-all": "^4.1.5",
    "prettier": "^3",
    "prop-types": "^15.8.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-scripts": "^5.0.1",
    "serve": "^14.2.6"
  },
  "files": [
    "dist"
  ],
  "dependencies": {}
}
